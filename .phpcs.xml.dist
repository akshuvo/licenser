<?xml version="1.0"?>
<ruleset name="Licenser WordPress Coding Standards">
	<description>PHP_CodeSniffer ruleset for the Licenser WordPress plugin.</description>

	<!-- CLI defaults -->
	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="./"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>

	<!-- Target files -->
	<file>.</file>

	<!-- Exclusions -->
	<exclude-pattern>*/.git/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern type="relative">build/*</exclude-pattern>

	<!-- Minimum supported WordPress and PHP versions -->
	<config name="minimum_wp_version" value="5.8"/>
	<config name="testVersion" value="7.4-"/>

	<!-- WordPress Coding Standards -->
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- Allow PSR-4 class filenames & modern short array syntax -->
	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
		<exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
	</rule>

	<!-- Enforce plugin text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="licenser"/>
			</property>
		</properties>
	</rule>

	<!-- Enforce global symbol prefixes -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="licenser"/>
				<element value="Licenser"/>
				<element value="LICENSER"/>
			</property>
		</properties>
		<exclude-pattern>*/includes/Admin/templates/*</exclude-pattern>
	</rule>
</ruleset>
